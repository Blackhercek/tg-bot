[Unit]
Description=Дневной баланс — трекеры питания и тренировок
After=network.target

[Service]
Type=simple
User=fitness
Group=fitness
WorkingDirectory=/opt/fitness
EnvironmentFile=/opt/fitness/.env
ExecStart=/opt/fitness/.venv/bin/gunicorn \
    --workers 1 --threads 4 \
    --bind 127.0.0.1:8000 \
    --access-logfile - --error-logfile - \
    app:app
Restart=always
RestartSec=3

# Изоляция: сервису доступна на запись только своя папка с данными.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fitness/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
