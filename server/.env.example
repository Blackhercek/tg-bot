# Скопировать в .env и заполнить. Файл не коммитится.
#
# 1) Секрет для подписи сессионной куки:
#    python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# 2) Хеш пароля (сам пароль нигде не хранится):
#    python3 app.py hash 'твой-пароль'
APP_PASSWORD_HASH=

# Путь к базе. По умолчанию data/fitness.db рядом с приложением.
DB_PATH=/opt/fitness/data/fitness.db

# Сколько дней держится сессия без повторного входа.
SESSION_DAYS=90

# 1 — куки только по HTTPS. Ставить 0 только для локальной отладки.
SECURE_COOKIE=1

PORT=8000
